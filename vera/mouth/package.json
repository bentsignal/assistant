{
  "name": "@vera/mouth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vera's local text to speech: Kokoro (sherpa-onnx) neural TTS, character DSP, low-latency playback, and chimes.",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "vera-say": "./src/cli.ts"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "say": "tsx src/cli.ts",
    "samples": "tsx scripts/samples.ts",
    "bench": "tsx scripts/bench.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:playback": "node --import tsx --test test/playback.live.ts",
    "typecheck": "tsc -p . --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
